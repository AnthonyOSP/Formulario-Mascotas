@model List<Proyecto_1.Models.Mascota>

@{
    ViewData["Title"] = "Registro de Mascotas";
}

<div class="row g-4 align-items-start" style="margin-top: 1.5rem;">
    <div class="col-md-5">
        <section class="ficha">
            <h2>Ficha de registro</h2>
            <div class="ficha-body">
                <form asp-controller="Mascotas" asp-action="Registrar" method="post" novalidate>
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>

                    <div class="campo">
                        <label for="Nombre">Nombre</label>
                        <input type="text" class="form-control" id="Nombre" name="Nombre" required />
                    </div>

                    <div class="campo">
                        <label for="Tipo">Tipo de mascota</label>
                        <select class="form-select" id="Tipo" name="Tipo" required>
                            <option value="">Seleccione...</option>
                            <option>Perro</option>
                            <option>Gato</option>
                            <option>Ave</option>
                            <option>Pez</option>
                            <option>Conejo</option>
                            <option>Hámster</option>
                            <option>Otro</option>
                        </select>
                    </div>

                    <div class="campo">
                        <label for="Raza">Raza</label>
                        <input type="text" class="form-control" id="Raza" name="Raza" placeholder="Ej. Criollo, Labrador, etc." required />
                    </div>

                    <div class="row">
                        <div class="col-6 campo">
                            <label for="Edad">Edad (años)</label>
                            <input type="number" min="0" step="1" class="form-control" id="Edad" name="Edad" required />
                        </div>
                        <div class="col-6 campo">
                            <label for="Peso">Peso (kg)</label>
                            <input type="number" min="0" step="0.1" class="form-control" id="Peso" name="Peso" required />
                        </div>
                    </div>

                    <div class="campo">
                        <label for="Color">Color</label>
                        <input type="text" class="form-control" id="Color" name="Color" />
                    </div>

                    <div class="campo">
                        <label for="Sexo">Sexo</label>
                        <select class="form-select" id="Sexo" name="Sexo">
                            <option value="">Seleccione...</option>
                            <option>Macho</option>
                            <option>Hembra</option>
                        </select>
                    </div>

                    <button type="submit" class="btn-presentar">Presentar</button>
                </form>
            </div>
        </section>
    </div>

    <div class="col-md-7">
        <section class="libro">
            <div class="libro-cabecera">
                <h2>Libro de registro</h2>
                <span class="libro-conteo">@Model.Count.ToString("D4") folio@(Model.Count == 1 ? "" : "s")</span>
            </div>

            @if (!Model.Any())
            {
                <div class="libro-vacio">
                    <span class="libro-vacio-linea"></span>
                    Aún no hay folios sellados en este libro.<br />
                    Presenta la primera ficha para abrir el registro.
                </div>
            }
            else
            {
                <div class="tabla-libro-wrap">
                    <table class="tabla-libro">
                        <thead>
                            <tr>
                                <th>Folio</th>
                                <th>Nombre</th>
                                <th class="col-tipo">Tipo</th>
                                <th>Raza</th>
                                <th>Edad</th>
                                <th>Peso (kg)</th>
                                <th>Color</th>
                                <th>Sexo</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{ var folio = 0; }
                            @foreach (var m in Model)
                            {
                                folio++;
                                <tr>
                                    <td class="folio">N.° @folio.ToString("D4")</td>
                                    <td>@m.Nombre</td>
                                    <td class="col-tipo">@m.Tipo</td>
                                    <td>@m.Raza</td>
                                    <td>@m.Edad</td>
                                    <td>@m.Peso</td>
                                    <td>@m.Color</td>
                                    <td>@m.Sexo</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </section>
    </div>
</div>
