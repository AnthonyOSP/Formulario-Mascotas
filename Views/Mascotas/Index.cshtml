@model List<Proyecto_1.Models.Mascota>

@{
    ViewData["Title"] = "Registro de Mascotas";
}

<h1 class="mb-4">Registro de Mascotas</h1>

<div class="row g-4">
    <div class="col-md-5">
        <div class="card shadow-sm">
            <div class="card-body">
                <h5 class="card-title mb-3">Registrar nueva mascota</h5>

                <form asp-controller="Mascotas" asp-action="Registrar" method="post">
                    @Html.AntiForgeryToken()

                    <div class="mb-3">
                        <label class="form-label">Nombre</label>
                        <input type="text" class="form-control" name="Nombre" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Tipo de mascota</label>
                        <select class="form-select" name="Tipo" required>
                            <option value="">Seleccione...</option>
                            <option>Perro</option>
                            <option>Gato</option>
                            <option>Ave</option>
                            <option>Pez</option>
                            <option>Conejo</option>
                            <option>Hámster</option>
                            <option>Otro</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Raza</label>
                        <input type="text" class="form-control" name="Raza" placeholder="Ej. Criollo, Labrador, etc." required />
                    </div>

                    <div class="row">
                        <div class="col-6 mb-3">
                            <label class="form-label">Edad (años)</label>
                            <input type="number" min="0" step="1" class="form-control" name="Edad" required />
                        </div>
                        <div class="col-6 mb-3">
                            <label class="form-label">Peso (kg)</label>
                            <input type="number" min="0" step="0.1" class="form-control" name="Peso" required />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Color</label>
                        <input type="text" class="form-control" name="Color" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Sexo</label>
                        <select class="form-select" name="Sexo">
                            <option value="">Seleccione...</option>
                            <option>Macho</option>
                            <option>Hembra</option>
                        </select>
                    </div>

                    <button type="submit" class="btn btn-primary w-100">Registrar mascota</button>
                </form>
            </div>
        </div>
    </div>

    <div class="col-md-7">
        <h5 class="mb-3">Mascotas registradas (@Model.Count)</h5>

        @if (!Model.Any())
        {
            <p class="text-muted">Aún no hay mascotas registradas.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-striped table-bordered align-middle">
                    <thead class="table-dark">
                        <tr>
                            <th>Nombre</th>
                            <th>Tipo</th>
                            <th>Raza</th>
                            <th>Edad</th>
                            <th>Peso (kg)</th>
                            <th>Color</th>
                            <th>Sexo</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var m in Model)
                        {
                            <tr>
                                <td>@m.Nombre</td>
                                <td>@m.Tipo</td>
                                <td>@m.Raza</td>
                                <td>@m.Edad</td>
                                <td>@m.Peso</td>
                                <td>@m.Color</td>
                                <td>@m.Sexo</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
