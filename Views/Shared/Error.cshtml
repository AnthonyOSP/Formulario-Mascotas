@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<div class="pagina-lectura">
    <h1 style="color: var(--color-error);">Error</h1>
    <p>Ocurrió un error al procesar la solicitud.</p>

    @if (Model.ShowRequestId)
    {
        <p>
            <strong>Request ID:</strong> <code>@Model.RequestId</code>
        </p>
    }

    <h3>Modo de desarrollo</h3>
    <p>
        Cambiar al entorno <strong>Development</strong> mostrará información más
        detallada sobre el error ocurrido.
    </p>
    <p>
        <strong>El entorno Development no debe habilitarse en aplicaciones desplegadas.</strong>
        Puede exponer información sensible de las excepciones a los usuarios finales.
        Para depuración local, habilita el entorno <strong>Development</strong> configurando
        la variable de entorno <strong>ASPNETCORE_ENVIRONMENT</strong> y reiniciando la aplicación.
    </p>
</div>
